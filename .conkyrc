# Standard antiX .conkyrc file
# For conky editing help and commands visit = Casey's Conky Reference with Examples {http://www.ifxgroup.net/conky.htm}
lua_load ~/.local/run/conky_helpers.lua
# --- Global Settings ---
background yes                        # Fork Conky into the background on startup
update_interval 1                   # Refresh rate in seconds1
cpu_avg_samples 5                     # Number of samples to average for CPU monitoring
net_avg_samples 5                     # Number of samples to average for net bandwidth
no_buffers yes                        # Subtract file system buffers from used memory

# --- Window Position & Sizing ---
alignment top_right             # Positions the box at the top_left corner
gap_x 0                         # Small gap from the right edge (adjust as needed)
gap_y 0                         # Small gap from the top edge (adjust as needed)
minimum_size 700 394             # Sets the box to exactly 800x800 (minimum)
maximum_width 700                # Caps the width at 800 pixels (makes it exactly 800)
maximum_height 394               # Caps the height at 800 pixels (makes it exactly 800)

# --- Graphical Tweaks & Transparency ---
own_window yes                        # Give Conky its own window instead of drawing on desktop
own_window_class Conky                # Set the window class name
own_window_type normal                # Window type
own_window_transparent no             # Must be 'no' when using ARGB visuals for true transparency
own_window_argb_visual yes            # Enable ARGB visual (allows true transparency/alpha channel)
own_window_argb_value 0               # Set transparency level (0 = fully transparent, 255 = opaque)
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager # Remove borders, keep below windows, keep on all workspaces

# --- Font and Colors ---
use_xft yes                           # Use X FreeType fonts (allows custom fonts and antialiasing)
uppercase yes                         # Force all text rendering to uppercase
xftalpha 1                            # Alpha/opacity level for XFT fonts (1 is fully opaque)
draw_shades no                        # Disable text shading
draw_outline no                       # Disable text outlining
draw_borders no                       # Disable window borders
draw_graph_borders no                 # Disable borders around any graphical elements
default_color 191919                   # Base color for all text elements

# --- Layout Output ---
TEXT
# Centers and renders the current day using the stylized Anurati font (Size 60)
${lua_parse conky_color_open}${font Arial Black:size=40}${time %A }${time %d }${time %B} ${time %y}${font}${lua_parse conky_color_close}

# Time display
#${lua_parse conky_color_open}${font Arial Black:size=40}${time %d }${time %B} ${time %Y}${font}${lua_parse conky_color_close}
${lua_parse conky_color_open}${font Impact:size=100}${time %I : %M %p}${font}${lua_parse conky_color_close}

